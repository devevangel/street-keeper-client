# Optional: API base URL (default: http://localhost:8000/api/v1)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: GPX/map engine. v1 = legacy (UserStreetProgress). v2 = edge-based (UserEdge).
# Set to v2 to use GET /engine-v2/map/streets and POST /engine-v2/analyze. Default: v1
# VITE_GPX_ENGINE=v1
